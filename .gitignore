# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Downloaded ML model sources (large; not shippable TFLite)
/tools/model_assets/source/
/tools/model_assets/tflite_out/

# Large binary assets — keep locally / download separately; do not push
/assets/models/*.tflite
/assets/tessdata/*.traineddata
*.onnx
*.pt

# Android build outputs (root /build/ does not cover this)
/android/build/
